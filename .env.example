# Environment configuration example for BOSAI Agent Memory Control Plane.
# Copy to .env and fill in values at runtime.
# NEVER commit a real .env file — it is listed in .gitignore.

# CockroachDB connection string (PostgreSQL-compatible wire protocol).
# Format: postgresql://<user>@<host>:<port>/<database>?sslmode=verify-full
DATABASE_URL=

# AWS region for S3 evidence bucket and Lambda execution.
AWS_REGION=eu-central-1

# S3 bucket name for execution evidence receipts.
# Created in milestone 0E — see docs/MILESTONE-0E-VERTICAL-SLICE.md.
EVIDENCE_BUCKET=
